{
    "name": "app/kalkulator-bayi",
    "type": "project",
    "description": "Kalkulator usia bayi dalam total bulan.",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fca5a5\" \"php artisan serve\" \"npm run dev\""
        ]
    },
    "config": {
        "optimize-autoloader": false,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
